# ──────────────────────────────────────────────────────────────
# AI Money Mentor — Auditor Agent Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Selection (llama3-8b-8192 is free & fast)
GROQ_MODEL=llama3-8b-8192

# FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Settings (auto-detected, change if needed)
STREAMLIT_PORT=8501
